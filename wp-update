#!/usr/bin/env node

const args = process.argv.slice(2, 3);

let plural = '';
let singular = '';

switch (args[0]) {

  case 'plugin' :
  case 'plugins' :
    plural = 'plugins';
    singular = 'plugin';
    break;

  case 'theme' :
  case 'themes' :
    plural = 'themes';
    singular = 'theme';
    break;
}

console.log(`Getting list of ${singular} updates...`);

const spawnSync = require('child_process').spawnSync;

try {
  const result = spawnSync('wp', [singular, 'update', '--all', '--dry-run', '--format=json'], { encoding : 'utf8' });

  // Check for system-level errors that didn't throw (e.g., timeouts)
  if (result.error) {
    if (result.error.code === 'ETIMEDOUT') {
      console.error('Execution timed out.');
    } else {
      console.error('System error:', result.error.message);
    }
    process.exit(1);
  }

  // Check for application-level errors (non-zero exit code)
  if (result.status !== 0) {
    console.error(`Command failed with exit code ${result.status}`);
    console.error(`Error output:\n`);
    console.error(`${result.stderr}`);
    process.exit(result.status || 1);
  }

  // Check for empty stdout
  if (result.stdout === '') {
    console.error(`No ${singular} updates available.`);
    process.exit(1);
  }

  updateJSON = result.stdout;
  updateData = JSON.parse(updateJSON);
} catch (error) {
  console.log(`Error getting list of ${singular} updates.`);
  console.log(error);
  // console.log(result.stdout);
  process.exit(1);
}

console.log(`Updating ${plural}...`);
console.log(`\n`);

const updatePath = spawnSync('wp', [singular, 'path'], { encoding : 'utf8' });

// const gitPath = spawnSync('git', ['rev-parse', '--show-toplevel'], { encoding : 'utf8' });
// const gitAddPath = `${gitPath.stdout.trim()}/${updatePath.stdout.trim().split('./')[1]}`;
const gitAddPath = updatePath.stdout.trim();

let updateData = [];
let updateList = [];
let errorList = [];

for (let update of updateData) {
  let updateJSON = spawnSync('wp', [singular, 'update', update.name, '--format=json'], { encoding : 'utf8' });
  let resultData;

  try {
    resultData = JSON.parse(updateJSON.stdout);
  } catch (e) {
    console.log(`Error updating ${singular} ${update.name} from ${update.version} to ${update.update_version}`);
    console.log(e);
    console.log(updateJSON.stdout);
    continue;
  }

  if (resultData[0].status == 'Updated') {
    const gitAdd = spawnSync('git', ['add', `${gitAddPath}/${update.name}`], { encoding : 'utf8' });
    let gitAddData;

    try {
      gitAddData = gitAdd;
      // gitAddData = JSON.parse(gitAdd.stdout);
    } catch (e) {
      // console.log(e);
      console.log(`Error commiting ${singular} update.`);
      console.log(gitAddData);
      console.log(gitAddData.stdout);
    }

    spawnSync('git', ['commit', '-m', `Update ${singular} ${update.name} from ${update.version} to ${update.update_version}`]);
    console.log(`Update ${singular} ${update.name} from ${update.version} to ${update.update_version}`);
    updateList.push(update);
  } else {
    console.log(`Error updating ${singular} ${update.name} from ${update.version} to ${update.update_version}`);
    errorList.push(update);
  }
}

console.log(`\n`);
console.log(`${updateList.length} ${plural} updated`);

if (updateList.length) {
  for (let update of updateList) {
    console.log(`${update.name} from ${update.version} to ${update.update_version}`);
  }
}

if (errorList.length) {
  console.log(`\n`);
  console.log(`${errorList.length} ${singular} errors`);

  for (let update of errorList) {
    console.log(`${update.name} from ${update.version} to ${update.update_version}`);
  }
}
